@page
@model Court.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}
@using CourtDomain.Enums
@using CourtDomain.DTOs;


@if (TempData["LoginSuccess"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3">

        <div id="loginToast"
             class="toast"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">

             <div class="toast-body d-flex align-items-center gap-2 py-3 px-4"
                   style="background-color: #e8f5e9; color: #2e7d32; border-radius: 8px;">
    
                 <span class="fw-semibold">Login successful!</span>
             </div>

        </div>

    </div>


    <script>
        document.addEventListener("DOMContentLoaded", function() {

            var toastElement = document.getElementById("loginToast");

            var toast = new bootstrap.Toast(toastElement, {
                delay: 1000
            });

            toast.show();
        });
    </script> 
}


<div class="container-fluid mt-3">

    <div class="card shadow-sm">

        <!-- Header -->
        <div class="card-header p-0 border-0">

            <div class="d-flex align-items-center">

                 <div class="text-white fw-bold px-3 py-2"
             style="background-color: #f39c12;">
            Complaints Awaiting Submission
        </div>

                <div class="bg-danger text-white fw-bold px-3 py-2">
                    @Model.TotalAwatingSubmission
                </div>

            </div>

        </div>

        <!-- Search -->
        <div class="card-body p-2">

            <div class="d-flex justify-content-end mb-2">

                <input type="text"
                       class="form-control table-search"
                       data-table="defendantTable"
                       placeholder="Search..."
                       style="width: 145px;" />

            </div>

            <!-- Table -->
            <div class="table-responsive">

                <table class="table table-striped table-bordered mb-0"
                       id="defendantTable">

                    <thead class="table-light">

                        <tr>
                            <th>Date</th>
                            <th>Defendant Name</th>
                            <th>Complaint Type</th>
                        </tr>

                    </thead>

                    <tbody>

                          @foreach (var item in Model.Defendants)
                        {
                            <tr>

                                <td>
                                   @(item.Date?.ToString("MMM-dd-yyyy") ?? "")
                                </td>

                                <td>
                                    @item.DefendantName
                                </td>

                                <td>
                                @item.ComplaintType
                                </td>

                                <td>
                                    <a asp-page="/Complaints/ComplaintSubmit"
                                       asp-route-complaintId="@item.ComplaintId"
                                       class="btn btn-primary btn-sm">
                                        Submission
                                    </a>
                                </td>

                            </tr>
                        } 

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<nav aria-label="Complaints awaiting submission pagination">
    <ul class="pagination">

        <!-- Previous -->
        <li class="page-item @(Model.SubmissionPageNumber <= 1 ? "disabled" : "")">
            <a class="page-link"
               asp-page="/Dashboard"
               asp-route-submissionPage="@(Model.SubmissionPageNumber - 1)">
                Previous
            </a>
        </li>

        <!-- Page Numbers -->
        @for (int i = 1; i <= Model.SubmissionTotalPage; i++)
        {
            <li class="page-item @(Model.SubmissionPageNumber == i ? "active" : "")">
                <a class="page-link"
                   asp-page="/Dashboard"
                   asp-route-submissionPage="@i">
                    @i
                </a>
            </li>
        }

        <!-- Next -->
        <li class="page-item @(Model.SubmissionPageNumber >= Model.SubmissionTotalPage ? "disabled" : "")">
            <a class="page-link"
               asp-page="/Dashboard"
               asp-route-submissionPage="@(Model.SubmissionPageNumber + 1)">
                Next
            </a>
        </li>

    </ul>
</nav>

