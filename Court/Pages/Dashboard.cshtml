 <!-- Upcoming court Case -->
<div class="container-fluid mt-3">

    <div class="card shadow-sm" id="arraignmentWidget">
        <div class="card-header p-0 border-0">
            <div class="d-flex align-items-center">

                <div class="text-white fw-bold px-3 py-2"
                     style="background-color: #f39c12;">
                    Upcoming Court Case
                </div>

                <div class="bg-danger text-white fw-bold px-3 py-2">
                    @Model.TotalArraignment
                </div>

            </div>
        </div>

           <div class="card-body p-2">

            <div class="d-flex justify-content-end mb-2">
                <input type="text"
                       class="form-control table-search"
                       data-table="petitionTable"
                       placeholder="Search..."
                       style="width: 145px;" />
            </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Petition Date</th>
                        <th>Defendant Name</th>
                        <th>Complaint Type</th>
                        <th>Approve By</th>
                        <th>Court Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Arraignments.Any())
                    {
                        @foreach (var item in Model.Arraignments)
                        {
                            <tr>
                                <td>@item.PetitionDate.ToString("dd-MMM-yyyy")</td>
                                <td>@item.DefendantName</td>
                                <td>@((CourtDomain.Enums.ComplaintType)item.ComplaintType)</td>
                                <td>@item.ApproveBy</td>
                                <td>
                                    @(item.CourtDate?.ToString("dd-MMM-yyyy") ?? "")
                                    @if (item.CourtTime.HasValue)
                                    {
                                        <span>@DateTime.Today.Add(item.CourtTime.Value).ToString("hh:mm tt")</span>
                                    }
                                </td>
                                 <td>
                                      @if (item.FinishAndLock)
                                    {
                                        <a asp-page="/Arraignments/ArraignmentHearing"
                                           asp-route-complaintId="@item.ComplaintId"
                                           asp-route-mode="view"
                                           class="btn btn-info btn-sm">
                                            View
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-page="/Arraignments/ArraignmentHearing"
                                           asp-route-complaintId="@item.ComplaintId"
                                           class="btn btn-primary btn-sm">
                                            Update
                                        </a>
                                    }
                                 </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                No arraignments found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
    </div>
</div>
<nav aria-label="Upcoming court cases pagination">
    <ul class="pagination">

        <!-- Previous -->
        <li class="page-item @(Model.ArraignmentPageNumber <= 1 ? "disabled" : "")">
            <a class="page-link"
