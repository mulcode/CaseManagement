<!-- Petitions -->
<div class="container-fluid mt-3">

    <div class="card shadow-sm" id ="petitionWidget">

        <!-- Header -->
        <div class="card-header p-0 border-0">
            <div class="d-flex align-items-center">

                <div class="text-white fw-bold px-3 py-2"
                     style="background-color: #f39c12;">
                    Petitions
                </div>

                <div class="bg-danger text-white fw-bold px-3 py-2">
                    @Model.TotalPetition
                </div>

            </div>
        </div>

        <!-- Search -->
        <div class="card-body p-2">

            <div class="d-flex justify-content-end mb-2">
                <input type="text"
                       class="form-control table-search"
                       data-table="petitionTable"
                       placeholder="Search..."
                       style="width: 145px;" />
            </div>

            <!-- Table -->
            <div class="table-responsive">

                <table class="table table-striped table-bordered mb-0"
                       id="petitionTable">

                    <thead class="table-light">
                        <tr>
                            <th>Petition Date</th>
                            <th>Defendant Name</th>
                            <th>Complaint Type</th>
                            <th>Approve By</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Petitions)
                        {
                            <tr>
                                <td>
                                    @item.PetitionDate.ToString("MMM-dd-yyyy")
                                </td>

                                <td>
                                    @item.DefendantName
                                </td>
                                <td>
                                   @((CourtDomain.Enums.ComplaintType)item.ComplaintType)
                                </td>

                                <td>
                                    @item.ApproveBy
                                </td>

                                <td>
                                    @if (item.FinishAndLock)
                                    {
                                        <a asp-page="/Petitions/Petition"
                                           asp-route-complaintId="@item.ComplaintId"
                                           asp-route-mode="view"
                                           class="btn btn-info btn-sm">
                                            View
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-page="/Petitions/Petition"
                                           asp-route-complaintId="@item.ComplaintId"
                                           class="btn btn-primary btn-sm">
                                            Update
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    </div>
</div>

<nav aria-label="Petition pagination">
    <ul class="pagination">

        <!-- Previous -->
        <li class="page-item @(Model.PetitionPageNumber <= 1 ? "disabled" : "")">
            <a class="page-link"
