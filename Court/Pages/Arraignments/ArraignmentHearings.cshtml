@page 
@model Court.Pages.Arraignments.ArraignmentHearingsModel
@{
  ViewData["Title"] = "Arraignments";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="container-fluid mt-4">

    <partial name="_ComplaintTabs"
             model="new Court.ViewModels.ComplaintTabsViewModels
             {
                 ComplaintId = Model.ComplaintId,
                 IsDecisionSaved = Model.IsDecisionSaved,
                 PetitionId = Model.PetitionId,
                 IsPetitionFinished = Model.IsPetitionFinished
             }" />

        <h4 class="mb-0">Arraignment Hearings</h4>
    <div class="d-flex justify-content-between align-items-center mb-4 mt-4">

        <a asp-page="/Arraignments/ArraignmentHearing"
           asp-route-complaintId="@Model.ComplaintId"
           class="btn btn-primary">
            Add New
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Arraignment Date</th>
                            <th>Signed</th>
                            <th>Sign Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                       
                            @foreach (var item in Model.Arraignments)
                            {
                                <tr>
                                    <td>
                                        @(item.ArraignmentDate?.ToString("dd MMM yyyy") ?? "-")
                                    </td>

                                    <td>
                                        @(Model.Users.FirstOrDefault(u => u.Id == item.JudgeId)?.UserName ?? "-")
                                    </td>

                                    <td>
                                        @(item.SignDate?.ToString("dd MMM yyyy") ?? "-")
                                    </td>

                                    <td>
                                 @if (item.FinishAndLock)
                                   {
                                  <a asp-page="/Arraignments/ArraignmentHearing"
                                     asp-route-complaintId="@Model.ComplaintId"
                                     asp-route-id="@item.Id"
                                     asp-route-mode="view"
                                     class="btn btn-info btn-sm">
                                     View
                                 </a>
                                  }
                              else
                               {
                              <a asp-page="/Arraignments/ArraignmentHearing"
                                asp-route-complaintId="@Model.ComplaintId"
                                asp-route-id="@item.Id"
                                class="btn btn-primary btn-sm">
                                Update
                              </a>
                               }
                              </td>
                             </tr>
                            }
                        
                       
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>

