
@page
@model Court.Pages.Documents.DocumentListModel
@{
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-body p-4">

            <!-- Complaint Tabs -->
            <partial name="_ComplaintTabs"
                     model="new Court.ViewModels.ComplaintTabsViewModels
                     {
                         ComplaintId = Model.ComplaintId,
                     }" />

            <!-- Documents Content -->
            <h3 class="text-center mb-4">Documents</h3>

            <div class="d-flex justify-content-end mb-3">
                <a asp-page="/Documents/Document"
                   asp-route-complaintId="@Model.ComplaintId"
                   class="btn btn-success">
                    Add Document
                </a>
            </div>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Document Date</th>
                        <th>Document Name</th>
                        <th>Document Type</th>
                        <th>Document</th>
                        <th>Comments</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var document in Model.Documents)
                    {
                        <tr>
                            <td>@document.DocumentDate</td>
                            <td>@document.DocumentName</td>
                            <td>@document.DocumentType</td>

                            <td>
                                <a asp-page-handler="ViewDocument"
                                   asp-route-id="@document.Id"
                                   target="_blank"
                                   class="btn btn-sm btn-primary">
                                    View
                                </a>
                            </td>

                            <td>@document.Comments</td>

                            <td>
                                <a asp-page="/Documents/Document"
                                   asp-route-id="@document.Id"
                                   asp-route-complaintId="@Model.ComplaintId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal-@document.Id">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>


<!-- Delete Modals -->
@foreach (var document in Model.Documents)
{
    <div class="modal fade"
         id="deleteModal-@document.Id"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-body">
                    Are you sure you want to delete this document?
                </div>

                <div class="modal-footer">

                    <form method="post"
                          asp-page-handler="Delete"
                          asp-route-id="@document.Id"
                          asp-route-complaintId="@Model.ComplaintId">

                        <button type="submit"
                                class="btn btn-danger">
                            Yes
                        </button>

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            No
                        </button>

                    </form>

                </div>
            </div>
        </div>
    </div>
}
