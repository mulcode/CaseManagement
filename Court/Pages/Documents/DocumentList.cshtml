@page
@model Court.Pages.Documents.DocumentListModel
@{
    ViewData["Title"] = "Documents";
    Layout = "_DefendantLayout";
    ViewData["DefendantId"] = Model.ComplaintTabs.DefendantId;
}

<div class="card shadow">
    <div class="card-body p-4">

        <partial name="_ComplaintTabs" model="Model.ComplaintTabs" />

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <h4 class="mb-3 text-secondary">Documents</h4>
        <div class="d-flex justify-content-start mb-4">
            <a asp-page="/Documents/Document"
               asp-route-complaintId="@Model.ComplaintId"
               class="btn btn-success">
                Add New
            </a>
        </div>


        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Document Date</th>
                        <th>Document Name</th>
                        <th>Document Type</th>
                        <th>Document</th>
                        <th>Comment</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var document in Model.Documents)
                    {
                        <tr>
                            <td>@document.DocumentDate.ToString("dd MMM yyyy")</td>
                            <td>@document.DocumentName</td>
                            <td>@document.DocumentType</td>
                            <td>
                                <a asp-page-handler="ViewDocument"
                                   asp-route-id="@document.Id"
                                   asp-route-complaintId="@Model.ComplaintId"
                                   target="_blank"
                                   class="btn btn-sm" style="background-color:#00BFFF; color: white;">
                                    View
                                </a>
                            </td>
                            <td>@document.Comments</td>

                            <td>
                                <a asp-page="/Documents/Document"
                                   asp-route-documentId="@document.Id"
                                   asp-route-complaintId="@Model.ComplaintId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal-@document.Id">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@if (Model.Documents != null)
{
    @foreach (var document in Model.Documents)
    {
        <div class="modal fade"
             id="deleteModal-@document.Id"
             tabindex="-1"
             aria-labelledby="deleteModalLabel-@document.Id"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-body">
                        Are you sure you want to delete this document?
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            No
                        </button>

                        <form method="post"
                              asp-page-handler="Delete"
                              asp-route-documentId="@document.Id"
                              asp-route-complaintId="@Model.ComplaintId">

                            <button type="submit"
                                    class="btn btn-danger">
                                Yes
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    }
}