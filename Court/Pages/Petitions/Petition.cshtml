@page
@model Court.Pages.Petitions.PetitionModel
@using CourtDomain.Enums
@{
    ViewData["Title"] = "Petition";
    Layout = "_DefendantLayout";
    ViewData["DefendantId"] = Model.ComplaintTabs.DefendantId;
}

<div class="card shadow">
    <div class="card-body p-4">

        <partial name="_ComplaintTabs" model="Model.ComplaintTabs" />

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <form method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="PetitionInfo.Id" />
            <input type="hidden" asp-for="PetitionInfo.ComplaintId" />

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label" asp-for="PetitionInfo.PetitionDate">
                        Petition Date<span class="text-danger">*</span>
                    </label>

                    <input type="date" asp-for="PetitionInfo.PetitionDate"
                           class="form-control" />

                    <span asp-validation-for="PetitionInfo.PetitionDate"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label" asp-for="PetitionInfo.PetitionTime">
                        Petition Time<span class="text-danger">*</span>
                    </label>

                    <input type="time"
                           asp-for="PetitionInfo.PetitionTime"
                           class="form-control" />
                </div>
            </div>

            <h5 class="mt-4">Undisciplined Allegations</h5>

            <div class="row mb-3 mt-3">
                <div class="col-md-8">
                    <div class="form-check">
                        <input type="checkbox"
                               asp-for="PetitionInfo.Disobedient"
                               class="form-check-input">

                        <label asp-for="PetitionInfo.Disobedient"
                               class="form-check-label">
                            Was regularly disobedient to parent/guardian/custodian
                        </label>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-8">
                    <div class="form-check">
                        <input type="checkbox"
                               asp-for="PetitionInfo.FoundInUnlawfulPlace"
                               class="form-check-input">

                        <label asp-for="PetitionInfo.FoundInUnlawfulPlace"
                               class="form-check-label">
                            Was regularly found in unlawful place
                        </label>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-8">
                    <div class="form-check">
                        <input type="checkbox"
                               asp-for="PetitionInfo.RanAway"
                               class="form-check-input">

                        <label asp-for="PetitionInfo.RanAway"
                               class="form-check-label">
                            Ran away from home for more than 24 hours
                        </label>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-8">
                    <div class="form-check">
                        <input type="checkbox"
                               asp-for="PetitionInfo.AbsentFromSchool"
                               class="form-check-input">

                        <label asp-for="PetitionInfo.AbsentFromSchool"
                               class="form-check-label">
                            Unlawfully absent from school when under 16
                        </label>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label" asp-for="PetitionInfo.SupportingFacts">
                        State facts supporting every element of alleged offense
                    </label>

                    <textarea class="form-control"
                              asp-for="PetitionInfo.SupportingFacts"
                              rows="3"></textarea>
                </div>
            </div>

            <hr class="my-4" />

            <!-- Decision Container -->
            <div class="decision-section">
                <div class="decision-header">
                    Decision of Magistrate
                </div>

                <div class="p-3">

                    <!-- Decision Selection -->
                    <div class="row mb-4">
                        <div class="col-md-8">
                            <label class="form-label" asp-for="PetitionInfo.MagistrateDecision">
                                Decision<span class="text-danger">*</span>
                            </label>

                            <select asp-for="PetitionInfo.MagistrateDecision"
                                    asp-items="Html.GetEnumSelectList<Decision>()"
                                    class="form-select">
                                <option value="">-- Select Decision --</option>
                            </select>

                            <span asp-validation-for="PetitionInfo.MagistrateDecision"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label" asp-for="PetitionInfo.MagistrateDecisionDate">
                                Decision Date<span class="text-danger">*</span>
                            </label>

                            <input type="date" asp-for="PetitionInfo.MagistrateDecisionDate"
                                   class="form-control" />

                            <span asp-validation-for="PetitionInfo.MagistrateDecisionDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" asp-for="PetitionInfo.MagistrateDecisionTime">
                                Decision Time
                            </label>

                            <input type="time"
                                   asp-for="PetitionInfo.MagistrateDecisionTime"
                                   class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label" asp-for="PetitionInfo.MagistrateId">
                                Magistrate Name<span class="text-danger">*</span>
                            </label>

                            <select asp-for="PetitionInfo.MagistrateId"
                                    class="form-select"
                                    id="magistrateName">
                                <option value="">-- Select User --</option>
                                @foreach (var user in Model.Users)
                                {
                                    <option value="@user.Id"
                                            data-signature="@user.UserName">
                                        @user.UserName
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="PetitionInfo.MagistrateId"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" asp-for="PetitionInfo.MagistrateSignature">
                                Magistrate Signature<span class="text-danger">*</span>
                            </label>

                            <input asp-for="PetitionInfo.MagistrateSignature"
                                   class="form-control signature-input"
                                   id="magistrateSignature" />

                            <span asp-validation-for="PetitionInfo.MagistrateSignature"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-check mt-3">
                        <input asp-for="PetitionInfo.FinishAndLock"
                               class="form-check-input" />

                        <label asp-for="PetitionInfo.FinishAndLock"
                               class="form-check-label">
                            Finish and Lock
                        </label>
                    </div>

                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                @if (Model.PetitionInfo.FinishAndLock)
                {
                }
                else if (Model.PetitionInfo.MagistrateDecision > 0)
                {
                    <button type="submit" class="btn btn-primary">
                        Update
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary">
                        Save
                    </button>
                }
            </div>

        </form>

    </div>
</div>

<style>
    .decision-section {
        border: 1px solid #dee2e6;
        border-radius: 4px;
        background-color: #ffffff;
        overflow: hidden;
    }

    .decision-header {
        background-color: #17c3df;
        color: white;
        font-size: 18px;
        padding: 8px 10px;
    }

    .signature-input {
        font-style: italic;
        font-family: cursive;
        font-size: 20px;
    }
</style>

<script>
    var magistrateName = document.getElementById("magistrateName");

    if (magistrateName) {
        magistrateName.addEventListener("change", function() {
            var selectedOption = this.options[this.selectedIndex];
            var signature = selectedOption.getAttribute("data-signature");

            document.getElementById("magistrateSignature").value = signature || "";
        });
    }
</script>