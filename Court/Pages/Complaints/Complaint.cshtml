@page 
@model Court.Pages.Complaints.ComplaintModel
@{
    ViewData["Title"] = "Complaint";
}
@using CourtDomain.Enums



<div class="container mt-5" >
    <div class="card shadow">
        <div class="card-body p-4">
            @*Nav Tab*@

        <partial name="_ComplaintTabs"

         model="new Court.ViewModels.ComplaintTabsViewModels
         {
              ComplaintId = Model.ComplaintId,
             IsDecisionSaved = Model.IsDecisionSaved,
             PetitionId = Model.PetitionId,
             IsPetitionFinished = Model.IsPetitionFinished
           
         }" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}


            <form method="post">

                  <input type="hidden" asp-for="ComplaintInfo.DefendantId" />
                   <input type="hidden" asp-for="ComplaintInfo.Id" />

                 <div class="row mb-3">

                 <div class="col-md-4">
                <label class="form-label">
                  Date<span style="color:red">*</span>
                </label>

            <input type="date"
                   asp-for="ComplaintInfo.Date"
                   class="form-control"
                   required />

            <span asp-validation-for="ComplaintInfo.Date"
                  class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Time<span style="color:red">*</span>
            </label>

            <input type="time"
                   asp-for="ComplaintInfo.Time"
                   class="form-control" />
                   <span asp-validation-for="ComplaintInfo.Time"
                  class="text-danger small"></span>
        </div>

    </div>

    <div class="row mb-3">

        <div class="col-md-4">
            <label class="form-label">
                Complaint Type<span style="color:red">*</span>
            </label>

            <select asp-for="ComplaintInfo.ComplaintType"
                    asp-items="Html.GetEnumSelectList<ComplaintType>()"
                    class="form-select">

                <option value="">Select Complaint Type</option>

            </select>

            <span asp-validation-for="ComplaintInfo.ComplaintType"
                  class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Offense Date<span style="color:red">*</span>
            </label>

            <input type="date"
                   asp-for="ComplaintInfo.OffesnseDate"
                   class="form-control" />
        </div>

    </div>

    <div class="row mb-3">

        <div class="col-md-6">
            <label class="form-label">
                Summary Of Complaints
            </label>

            <textarea class="form-control"
                      asp-for="ComplaintInfo.SummaryOfComplaint"></textarea>
        </div>

    </div>

   
    <div class="d-flex justify-content-end gap-2 mt-4">

    @if (Model.ComplaintInfo.Id == 0)
    {
        <button type="submit" class="btn btn-primary">
            Save
        </button>
    }
    else
    {
        <button type="submit" class="btn btn-warning">
            Update
         </button>
    }

    @* <a asp-page="/Complaints/ComplaintList"
       class="btn btn-secondary">
        Cancel
    </a> *@

</div>

</form>
        </div>
    </div>
</div>




