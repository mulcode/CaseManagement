@page 
@model Court.Pages.Complaints.ComplaintModel
@{
}
@using CourtDomain.Enums


<div class="container mt-5" >
    <div class="card shadow">
        <div class="card-body p-4">
<ul class="nav nav-tabs mb-4">
                <li class="nav-item">
                    <a class="nav-link active"
                       asp-page="/Complaints/Complaint"
                       asp-route-id="@Model.ComplaintInfo.Id">
                        Complaints
                    </a>
                </li>

    <li class="nav-item">
        <a class="nav-link"
           asp-page="/Documents/DocumentList"
           asp-route-complaintId="@Model.ComplaintInfo.Id">
            Documents
        </a>
    </li>
                <li class="nav-item">
                    <a class="nav-link"
                       asp-page="/Complaints/ComplaintSubmit"
                       asp-route-complaintId="@Model.ComplaintInfo.Id">
                        Submit
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.HttpContext.Request.Path.StartsWithSegments("/Complaints/ComplaintDecision") ? "active" : "")"
                       href="javascript:void(0);"
                       onclick="openDecision(@Model.ComplaintInfo.Id)">
                        Decision
                    </a>
                </li>
                  <li class="nav-item">
                    <a class="nav-link"
                       asp-page="/Complaints/ComplaintPetition"
                       asp-route-complaintId="@Model.ComplaintInfo.Id">
                        Petition
                    </a>
                </li>
               </ul>

            <h3 class="text-center">Complaint Information</h3>

            <form method="post">

                  <input type="hidden" asp-for="ComplaintInfo.DefendantId" />
                   <input type="hidden" asp-for="ComplaintInfo.Id" />

                 <div class="row mb-3">

                 <div class="col-md-4">
                <label class="form-label">
                  Date<span style="color:red">*</span>
                </label>

            <input type="date"
                   asp-for="ComplaintInfo.Date"
                   class="form-control"
                   required />

            <span asp-validation-for="ComplaintInfo.Date"
                  class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Time
            </label>

            <input type="time"
                   asp-for="ComplaintInfo.Time"
                   class="form-control" />
        </div>

    </div>

    <div class="row mb-3">

        <div class="col-md-4">
            <label class="form-label">
                Complaint Type
            </label>

            <select asp-for="ComplaintInfo.ComplaintType"
                    asp-items="Html.GetEnumSelectList<ComplaintType>()"
                    class="form-select">

                <option value="">Select Complaint Type</option>

            </select>

            <span asp-validation-for="ComplaintInfo.ComplaintType"
                  class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Offense Date
            </label>

            <input type="date"
                   asp-for="ComplaintInfo.OffesnseDate"
                   class="form-control" />
        </div>

    </div>

    <div class="row mb-3">

        <div class="col-md-6">
            <label class="form-label">
                Summary Of Complaints
            </label>

            <textarea class="form-control"
                      asp-for="ComplaintInfo.SummaryOfComplaint"></textarea>
        </div>

    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">

        <button type="button"
                class="btn btn-secondary">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-primary">
            Save
        </button>

    </div>

</form>
        </div>
    </div>
</div>

<div class="modal fade" id="decisionModal" tabindex="-1"
     aria-labelledby="decisionModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-body text-center">
                <p class="mb-0">
                    Submit the complaint first.
                </p>
            </div>

            <div class="modal-footer justify-content-center">
                <button type="button"
                        class="btn btn-primary"
                        data-bs-dismiss="modal">
                    OK
                </button>
            </div>

        </div>
    </div>
</div>

<script>
    function openDecision(complaintId) {

        fetch('/Complaints/Complaint?handler=CheckDecision&complaintId=' + complaintId)
            .then(response => response.json())
            .then(data => {

                if (data.readyForApproval) {

                    window.location.href =
                        '/Complaints/ComplaintDecision?complaintId=' + complaintId;

                } else {

                    var decisionModal = new bootstrap.Modal(
                        document.getElementById('decisionModal')
                    );

                    decisionModal.show();
                }
            });
    }
</script>