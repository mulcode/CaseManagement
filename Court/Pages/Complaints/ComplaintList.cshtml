
@page "/Complaints"
@model Court.Pages.Complaints.ComplaintListModel

@{
    ViewData["Title"] = "Complaints";
}
@{
    Layout = "_DefendantLayout";
    ViewData["DefendantId"] = Model.DefendantId;
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-body p-4">

            <h3 class="text-center mb-4">Complaints</h3>

            <!-- Success Message -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">
                    @TempData["SuccessMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>
                </div>
            }

            <!-- Error Message -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show"
                     role="alert">
                    @TempData["ErrorMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>
                </div>
            }

            <!-- Add New Complaint -->
            <div class="d-flex justify-content-start mb-3">
                <a asp-page="/Complaints/Complaint"
                   asp-route-defendantId="@Model.DefendantId"
                   class="btn btn-success">
                    Add New Complaint
                </a>
            </div>

            <!-- Complaints Table -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Complaint Date</th>
                            <th>Time</th>
                            <th>Complaint Type</th>
                            <th>Offense Date</th>
                            <th>Summary Of Complaints</th>
                            <th style="min-width: 150px;">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Complaints != null &&
                             Model.Complaints.Any())
                        {
                            @foreach (var complaint in Model.Complaints)
                            {
                                <tr>
                                    <td>@complaint.Date</td>
                                    <td>@complaint.Time</td>
                                    <td>@complaint.ComplaintType</td>
                                    <td>@complaint.OffesnseDate</td>
                                    <td>@complaint.SummaryOfComplaint</td>

                                    <td>
                                        <!-- View Button -->
                                        <a asp-page="/Complaints/Complaint"
                                           asp-route-complaintId="@complaint.Id"
                                           class="btn btn-sm " style="background-color:#00BFFF; color: white;">
                                            View
                                        </a>

                                        <!-- Delete Button -->
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal-@complaint.Id">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-3">
                                    No complaints found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- Delete Confirmation Modals -->
@if (Model.Complaints != null)
{
    @foreach (var complaint in Model.Complaints)
    {
        <div class="modal fade"
             id="deleteModal-@complaint.Id"
             tabindex="-1"
             aria-labelledby="deleteModalLabel-@complaint.Id"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-body">
                        Are you sure you want to delete this complaint?
                    </div>

                    <div class="modal-footer">
                        <form method="post"
                              asp-page-handler="Delete"
                              asp-route-complaintId="@complaint.Id">

                            <button type="submit"
                                    class="btn btn-danger">
                                Yes
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    }
}
