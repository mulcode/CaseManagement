@page "/Complaints"
@model Court.Pages.Complaints.ComplaintListModel
@{
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-body p-4">

            <h3 class="text-center mb-4">Complaints</h3>

            <div class="d-flex justify-content-start mb-3">
                <a asp-page="/Complaints/Complaint"
                   asp-route-defendantId="@Model.DefendantId"
                   class="btn btn-success">
                    Add New Complaint
                </a>
            </div>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Complaint Date</th>
                        <th>Time</th>
                        <th>Complaint Type</th>
                        <th>Offense Date</th>
                        <th>Summary Of Complaints</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var complaint in Model.Complaints)
                    {
                        <tr>
                            <td>@complaint.Date</td>
                            <td>@complaint.Time</td>
                            <td>@complaint.ComplaintType</td>
                            <td>@complaint.OffesnseDate</td>
                            <td>@complaint.SummaryOfComplaint</td>

                            <td>
                                <a asp-page="/Complaints/Complaint"
                                   asp-route-id="@complaint.Id"
                                   class="btn btn-sm btn-warning">
                                    View
                                </a>

                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal-@complaint.Id">
                                    Delete
                                </button>
                            </td>
                        </tr>

<div class="modal fade" id="deleteModal-@complaint.Id" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Delete Complaint</h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                Are you sure you want to delete this complaint?
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form method="post"
                      asp-page-handler="Delete"
                      asp-route-id="@complaint.Id">

                    <button type="submit" class="btn btn-danger">
                        Confirm Delete
                    </button>

                </form>
            </div>

        </div>
    </div>
</div>

                    }
                </tbody>
            </table>

        </div>
    </div>
</div>