@page "/Complaints"
@model Court.Pages.Complaints.ComplaintListModel
@{
}


<h2 class="mb-4">Complaints</h2>

<a asp-page="/Complaints/Complaint"
   target="_blank"
    asp-route-defendantId="@Model.DefendantId"
   class="btn btn-success">
    Add new Complaint
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Complaint Date</th>
            <th>Time</th>
            <th>Complaint Type</th>
            <th>Offense Date</th>
            <th>Summery Of Complaints</th>
            <th>Action</th>
        </tr>
    </thead>

     <tbody>
        @foreach (var complaint in Model.Complaints)
        {
            <tr>
                <td>@complaint.Date</td>
                <td>@complaint.Time</td>
                <td>@complaint.ComplaintType</td>
                <td>@complaint.OffesnseDate</td>
                <td>@complaint.SummaryOfComplaint</td>

                <td>
                    <a asp-page="/Complaints/Complaint"
                       asp-route-id="@complaint.Id"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <form method="post"
                          asp-page-handler="Delete"
                          asp-route-id="@complaint.Id"
                          style="display:inline;">
                        <button type="submit"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('Are you sure you want to delete this complaint?');">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody> 
</table>