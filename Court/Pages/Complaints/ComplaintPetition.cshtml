@page
@model Court.Pages.Complaints.ComplaintPetitionModel
@{
}
@using CourtDomain.Enums


<div class="container mt-5" >
    <div class="card shadow">
        <div class="card-body p-4">
 <ul class="nav nav-tabs mb-4">

                <!-- Complaints -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.HttpContext.Request.Path.StartsWithSegments("/Complaints/ComplaintList") ? "active" : "")"
                       asp-page="/Complaints/ComplaintList"
                    asp-route-complaintId="@Model.ComplaintInfo.Id">
                        Complaints
                    </a>
                </li>

                <!-- Documents -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.HttpContext.Request.Path.StartsWithSegments("/Documents/DocumentList") ? "active" : "")"
                       asp-page="/Documents/DocumentList"
                    asp-route-complaintId="@Model.ComplaintInfo.Id">
                        Documents
                    </a>
                </li>

                <!-- Submit -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.HttpContext.Request.Path.StartsWithSegments("/Complaints/ComplaintSubmit") ? "active" : "")"
                       asp-page="/Complaints/ComplaintSubmit"
                    asp-route-complaintId="@Model.ComplaintInfo.Id">
                        Submit
                    </a>
                </li>

                <!-- Decision -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.HttpContext.Request.Path.StartsWithSegments("/Complaints/ComplaintDecision") ? "active" : "")"
                       asp-page="/Complaints/ComplaintDecision"
                       asp-route-complaintId="@Model.ComplaintInfo.Id">
                        Decision
                    </a>
                </li>
                 <li class="nav-item">
                    <a class="nav-link @(ViewContext.HttpContext.Request.Path.StartsWithSegments("/Complaints/ComplaintPetition") ? "active" : "")"
                       asp-page="/Complaints/ComplaintPetition"
                       asp-route-complaintId="@Model.ComplaintInfo.Id">
                        Petition
                    </a>
                </li>
            </ul>

            <form method="post">

                  <input type="hidden" asp-for="ComplaintInfo.DefendantId" />
                   <input type="hidden" asp-for="ComplaintInfo.Id" />

                 <div class="row mb-3">

                 <div class="col-md-4">
                <label class="form-label">
                 Petition Date
                </label>

            <input type="date"
                   asp-for="ComplaintInfo.PetitionDate"
                   class="form-control"
                    />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Petition Time
            </label>

            <input type="time"
                   asp-for="ComplaintInfo.PetitionTime"
                   class="form-control" />
        </div>

    </div>
    <h5>Undisciplined Allegations</h5>
    <div class="row mb-3 mt-4">
                <div class="col-md-8">
                        <div class="form-check mt-6">
                            <input type="checkbox"
                                   asp-for="ComplaintInfo.Disobedient"
                                   class="form-check-input">

                            <label for="disobedient"
                                   class="form-check-label">
                                Was regularly disobedient to parent/guardian/cutodian
                            </label>
                        </div>
                </div>
    </div>

      <div class="row mb-3">
                <div class="col-md-8">
                        <div class="form-check mt-4">
                            <input type="checkbox"
                                   asp-for="ComplaintInfo.FoundInUnlawfulPlace"
                                   class="form-check-input">

                            <label for="foundUnlawful"
                                   class="form-check-label">
                                Was regularly found in unlawful place
                            </label>
                        </div>
                </div>
    </div>

         <div class="row mb-3">
                <div class="col-md-8">
                        <div class="form-check mt-4">
                            <input type="checkbox"
                                   asp-for="ComplaintInfo.RanAway"
                                   class="form-check-input">

                            <label for="ranAway"
                                   class="form-check-label">
                                Ran away from home for more than 24 hours
                            </label>
                        </div>
                </div>
         </div>

            <div class="row mb-3">
                <div class="col-md-8">
                        <div class="form-check mt-4">
                            <input type="checkbox"
                                   asp-for="ComplaintInfo.AbsentFromSchool"
                                   class="form-check-input">

                            <label for="absentSchool"
                                   class="form-check-label">
                                Unlawfully absent fromschool when under 16
                            </label>
                        </div>
                </div>
         </div>
    <div class="row mb-3">

        <div class="col-md-6">
            <label class="form-label">
                State facts supporting every element of alleged offense
            </label>

            <textarea class="form-control"
                      asp-for="ComplaintInfo.SupportingFacts"></textarea>
        </div>

    </div>

<hr class="my-4" />

<div class="decision-section">

    <!-- Header -->
    <div class="decision-header">
        Decision of Magistrate
    </div>

    <div class="p-3">

        <!-- Decision -->
        <div class="row mb-4">
            <div class="col-md-8">
                <label class="form-label">Decision</label>

                <select asp-for="ComplaintInfo.MagistrateDecision"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<Decision>()">
                    <option value="">Select Decision</option>
                </select>
            </div>
        </div>


    <div class="row mb-3">

        <div class="col-md-4">
            <label class="form-label">
                Decision Date
            </label>

            <input type="date"
                   asp-for="ComplaintInfo.MagistrateDecisionDate"
                   class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Decision Time
            </label>

            <input type="time"
                   asp-for="ComplaintInfo.MagistrateDecisionTime"
                   class="form-control" />
        </div>
    </div>

     <div class="row mb-3">

                    <div class="col-md-4">
                        <label class="form-label">
                            Magistrate Name
                        </label>   
                          <select asp-for="ComplaintInfo.MagistrateId"
                                    class="form-select"
                                    id="magistrateName">

                                <option value="">Select Magistrate</option>

                                @foreach (var user in Model.Users)
                                {
                                    <option value="@user.Id"
                                            data-signature="@user.UserName">
                                        @user.UserName
                                    </option>
                                }

                            </select>
                    </div>
                     <div class="col-md-4">
                       <label class="form-label">
                           Magistrate Signature
                       </label>
                    <input asp-for="ComplaintInfo.MagistrateSignature"
                           class="form-control signature-input"
                           id="magistrateSignature"/>
                 </div>
            </div>

    <div class="form-check mt-3">
        <input asp-for="ComplaintInfo.FinishAndLock"
               class="form-check-input" />

        <label asp-for="ComplaintInfo.FinishAndLock"
               class="form-check-label">
            Finish and Lock
        </label>
    </div>

</div>

    <div class="d-flex justify-content-end gap-2 mt-4">

        @if (Model.ComplaintInfo.FinishAndLock)
        {

        }
        else if(Model.IsPetitionSaved)
        {
             <button type="submit"
                class="btn btn-secondary">
                Update
              </button>
        }
       else
       {
           <button type="submit"
                class="btn btn-primary">
                Save
            </button>
       }

        

    </div>

</form>
        </div>
    </div>
</div>


<style>
    .decision-section {
        border: 1px solid #dee2e6;
        border-radius: 4px;
        background-color: #ffffff;
        overflow: hidden;
    }

    .decision-header {
        background-color: #17c3df;
        color: white;
        font-size: 18px;
        padding: 8px 10px;
    }

    .signature-input {
         font-style: italic;
         font-family: cursive;
         font-size: 20px;
        }
</style>

<script>
    var magistrateName = document.getElementById("magistrateName");

    if (magistrateName) {
        magistrateName.addEventListener("change", function () {

            var selectedOption =
                this.options[this.selectedIndex];

            var signature =
                selectedOption.getAttribute("data-signature");

            document.getElementById("magistrateSignature").value =
                signature || "";
        });
    }
</script>
