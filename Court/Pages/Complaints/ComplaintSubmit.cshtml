@page
@model Court.Pages.Complaints.ComplaintSubmitModel
@{
    ViewData["Title"] = "Submit";
    Layout = "_DefendantLayout";
    ViewData["DefendantId"] = Model.ComplaintTabs.DefendantId;
}

<!-- Decision Modal -->
<div class="modal fade" id="decisionModal" tabindex="-1" aria-labelledby="decisionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                Approve the Complaint First
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

<div class="card shadow">
    <div class="card-body p-4">

        <partial name="_ComplaintTabs" model="Model.ComplaintTabs" />

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger decision-warning">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" enctype="multipart/form-data">

            <input type="hidden" asp-for="ComplaintInfo.Id" />
            <input type="hidden" asp-for="ComplaintInfo.DefendantId" />
            <input type="hidden" asp-for="ComplaintInfo.Date" />
            <input type="hidden" asp-for="ComplaintInfo.Time" />

            <div class="row mb-3">

                <!-- Complainant Name -->
                <div class="col-md-4">
                    <label class="form-label">
                        Complainant Name<span style="color:red">*</span>
                    </label>

                    <select asp-for="ComplaintInfo.ComplainantId"
                            class="form-select"
                            id="complainantName">
                        <option value="0">-- Select CIPD User --</option>

                        @foreach (var user in Model.ComplainantUsers)
                        {
                            <option value="@user.Id"
                                    data-signature="@user.UserName">
                                @user.UserName
                            </option>
                        }
                    </select>

                    <span asp-validation-for="ComplaintInfo.ComplainantId"
                          class="text-danger"></span>
                </div>

                <!-- Complainant Signature -->
                <div class="col-md-4">
                    <label class="form-label">
                        Complainant Signature<span style="color:red">*</span>
                    </label>

                    <input asp-for="ComplaintInfo.ComplainantSignature"
                           class="form-control signature-input"
                           id="complainantSignature" />

                    <span asp-validation-for="ComplaintInfo.ComplainantSignature"
                          class="text-danger"></span>
                </div>

                <!-- Complainant Phone -->
                <div class="col-md-4">
                    <label class="form-label">
                        Complainant Phone
                    </label>

                    <input asp-for="ComplaintInfo.ComplainantPhone"
                           class="form-control" />
                </div>

            </div>

            <div class="row mb-3">

                <div class="col-md-4">
                    <label class="form-label">
                        Badge Number
                    </label>

                    <input asp-for="ComplaintInfo.BadgeNumber"
                           class="form-control" />
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check mb-2">

                        <input asp-for="ComplaintInfo.ReadyForApproval"
                               class="form-check-input" />

                        <label class="form-check-label">
                            Ready for Approval
                        </label>
                    </div>
                </div>

            </div>

            @if (!Model.ComplaintInfo.ReadyForApproval &&
                 User.HasClaim("UserType", "CIPD"))
            {
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="submit"
                            class="btn btn-primary">
                        Save
                    </button>
                </div>
            }

        </form>

    </div>
</div>

<style>
    .signature-input {
        font-style: italic;
        font-family: cursive;
        font-size: 20px;
    }

    .decision-warning {
        background-color: #dc3545;
        color: white;
        padding: 6px 12px;
        margin-top: 5px;
        margin-bottom: 8px;
        border-radius: 4px;
        text-align: center;
    }
</style>

<script>
    var complainantName = document.getElementById("complainantName");

    if (complainantName) {
        complainantName.addEventListener("change", function() {

            var selectedOption = this.options[this.selectedIndex];

            var signature = selectedOption.getAttribute("data-signature");

            document.getElementById("complainantSignature").value = signature || "";
        });
    }

    // showing submit tab

        function openDecision(complaintId) {

            fetch('/Complaints/ComplaintSubmit?handler=CheckDecision&complaintId=' + complaintId)
            .then(response => response.json())
            .then(data => {

                    if (data.readyForApproval) {

                        window.location.href =
                        '/Complaints/ComplaintDecision?complaintId=' + complaintId;

                    } else {

                        var decisionModal = new bootstrap.Modal(
                        document.getElementById('decisionModal')
                        );

                        decisionModal.show();
                    }
                });
        }
</script>