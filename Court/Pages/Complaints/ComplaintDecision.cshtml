@page
@model Court.Pages.Complaints.ComplaintDecisionModel
@{
}
@using CourtDomain.Enums

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}


<div class="container mt-5">
    <div class="card shadow">
        <div class="card-body p-4">

            <ul class="nav nav-tabs mb-4">

                <!-- Complaints -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.HttpContext.Request.Path.StartsWithSegments("/Complaints/ComplaintList") ? "active" : "")"
                       asp-page="/Complaints/ComplaintList"
                    asp-route-complaintId="@Model.ComplaintInfo.Id">
                        Complaints
                    </a>
                </li>

                <!-- Documents -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.HttpContext.Request.Path.StartsWithSegments("/Documents/DocumentList") ? "active" : "")"
                       asp-page="/Documents/DocumentList"
                    asp-route-complaintId="@Model.ComplaintInfo.Id">
                        Documents
                    </a>
                </li>

                <!-- Submit -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.HttpContext.Request.Path.StartsWithSegments("/Complaints/ComplaintSubmit") ? "active" : "")"
                       asp-page="/Complaints/ComplaintSubmit"
                    asp-route-complaintId="@Model.ComplaintInfo.Id">
                        Submit
                    </a>
                </li>

                <!-- Decision -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.HttpContext.Request.Path.StartsWithSegments("/Complaints/ComplaintDecision") ? "active" : "")"
                       asp-page="/Complaints/ComplaintDecision"
                    asp-route-complaintId="@Model.ComplaintInfo.Id">
                        Decision
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.HttpContext.Request.Path.StartsWithSegments("/Complaints/ComplaintPetition") ? "active" : "")"
                       asp-page="/Complaints/ComplaintPetition"
                       asp-route-complaintId="@Model.ComplaintInfo.Id">
                        Petition
                    </a>
                </li>
            </ul>

            
             <form method="post" enctype="multipart/form-data">

                <input type="hidden" asp-for="ComplaintInfo.Id" />
                 <input type="hidden" asp-for="ComplaintInfo.DefendantId" />
 
                  <div class="row mb-3">

                    <div class="col-md-4">
                        <label class="form-label">
                            Magistrate Name
                        </label>   
                          <select asp-for="ComplaintInfo.MagistrateId"
                                    class="form-select"
                                    id="magistrateName">

                                <option value="">-- Select User --</option>

                                @foreach (var user in Model.Users)
                                {
                                    <option value="@user.Id"
                                            data-signature="@user.UserName">
                                        @user.UserName
                                    </option>
                                }

                            </select>
                    </div>

    <!-- Complainant Signature -->
    <div class="col-md-4">
    <label class="form-label">
        Magistrate Signature
    </label>
        <input asp-for="ComplaintInfo.MagistrateSignature"
               class="form-control signature-input"
               id="magistrateSignature"
                />
</div>


    <!-- Complainant Phone -->
    <div class="col-md-4">
    <label class="form-label">
        Date Received By Magistrate
    </label>

        <input asp-for="ComplaintInfo.ReceivedDateByMagistrate"
               class="form-control"
               />
</div>

</div>


<div class="row mb-3">
  <div class="col-md-6">
                        <label class="form-label">
                            Magistrate Decision
                        </label>   
                            <select asp-for="ComplaintInfo.MagistrateDecision"
                              asp-items="Html.GetEnumSelectList<Decision>()"
                                    class="form-select"
                                    >
                                    <option value="">
                                    </option>
                                
                            </select>
                    </div>

              </div>
  


    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="submit"
                class="btn btn-primary">
            Save
        </button>
    </div>
            </form>
        </div>
    </div>
</div>

<style>
    .signature-input {
         font-style: italic;
         font-family: cursive;
         font-size: 20px;
        }
</style>

<script>
    var magistrateName = document.getElementById("magistrateName");

    if (magistrateName) {
        magistrateName.addEventListener("change", function () {

            var selectedOption =
                this.options[this.selectedIndex];

            var signature =
                selectedOption.getAttribute("data-signature");

            document.getElementById("magistrateSignature").value =
                signature || "";
        });
    }
</script>