<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Court.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
       @{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isFiling = currentPage?.Contains("/Defendants") == true
                || currentPage?.Contains("/Complaints") == true
                || currentPage?.Contains("/Documents") == true
                || currentPage?.Contains("/Petitions") == true
                || currentPage?.Contains("/Arraignments") == true;
}

<nav class="navbar navbar-expand-lg navbar-dark"
     style="background-color: #274C77;">
    <div class="container-fluid px-0">

        <a class="navbar-brand text-white ps-3 pe-4 me-5"
           style="border-right: 1px solid rgba(255,255,255,0.18);"
           asp-area=""
           asp-page="/Index">
            Court System
        </a>

        <button class="navbar-toggler me-3"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#courtNavbar"
                aria-controls="courtNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="courtNavbar">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <ul class="navbar-nav">

                    <li class="nav-item">
                        <a class="nav-link @(currentPage?.Equals("/Dashboard", StringComparison.OrdinalIgnoreCase) == true ? "active fw-bold" : "")"
                           asp-page="/Dashboard">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(isFiling ? "active fw-bold" : "")"
                           asp-page="/Defendants/DefendantList">
                            Filing
                        </a>
                    </li>

                </ul>

                
  <ul class="navbar-nav ms-auto me-0">
                        <li class="nav-item d-flex align-items-center">

                            <span class="me-3 text-white">
                                <strong>@User.Identity.Name</strong>
                            </span>

                            <form method="post" asp-page="/Logout">
                                <button class="btn btn-danger btn-sm"
                                        type="submit">
                                    Logout
                                </button>
                            </form>

                        </li>
                    </ul>
 }
 </div>

    </div>
</nav>
</header>

    


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted" asp-page="/Login" asp-page-handler="Logout">
        <div class="container">
            &copy; 2026 - Court - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

<script>
    document.addEventListener("input", clearValidation);
    document.addEventListener("change", clearValidation);

    function clearValidation(event) {
        const field = event.target;

        if (!field.matches("input, select, textarea")) return;
        if (!field.checkValidity()) return;

        const error = document.querySelector(
            `[data-valmsg-for="${field.name}"]`
        );

        if (error) {
            error.textContent = "";
            error.classList.remove("field-validation-error");
            error.classList.add("field-validation-valid");
        }

        field.classList.remove("input-validation-error");
    }
</script>


</html>
