<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Court</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Court.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
    <nav class="navbar navbar-expand-sm shadow-sm mb-3"
         style="background-color: #1f4e78;">

        <div class="container">

            <!-- Court -->
            <a class="navbar-brand text-white pe-4 me-3"
               style="border-right: 1px solid rgba(255,255,255,0.18);"
               asp-area=""
               asp-page="/Index">
                Court
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse">

                <!-- Left menu -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                <ul class="navbar-nav">

                    <li class="nav-item">
                        <a class="navbar-brand text-white pe-4 me-3"
                           style="border-right: 2px solid rgba(255,255,255,0.18);"
                           asp-area=""
                           asp-page="/Dashboard">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="navbar-brand text-white pe-4 me-3"
                           style="border-right: 1px solid rgba(255,255,255,0.18);"
                           asp-area=""
                           asp-page="/Defendants/DefendantList">
                            Filing
                        </a>
                    </li>

                </ul>

                <!-- Right side -->
                
                    <ul class="navbar-nav ms-auto me-0">
                        <li class="nav-item d-flex align-items-center">

                            <span class="me-3 text-white">
                                <strong>@User.Identity.Name</strong>
                            </span>

                            <form method="post" asp-page="/Logout">
                                <button class="btn btn-danger btn-sm"
                                        type="submit">
                                    Logout
                                </button>
                            </form>

                        </li>
                    </ul>
                }

            </div>
        </div>
    </nav>
</header>

    


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted" asp-page="/Login" asp-page-handler="Logout">
        <div class="container">
            &copy; 2026 - Court - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
